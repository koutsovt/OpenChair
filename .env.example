DATABASE_URL=postgresql://user:password@localhost:5432/openchair
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional (LOCAL DEV ONLY): set to "true" to skip Twilio webhook signature
# validation for local testing. Has NO effect when NODE_ENV=production, so the
# public SMS webhook can never be left unauthenticated in prod (BP-002).
# TWILIO_SKIP_SIGNATURE=true
CRON_SECRET=
# Optional: set to "true" to enable the GET /demo one-click demo login in production.
# Disabled by default in production to prevent anonymous auth bypass (BP-001).
# ENABLE_DEMO_LOGIN=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
SKIP_ENV_VALIDATION=
