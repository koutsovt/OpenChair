generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTH & USERS (staff only — clients don't need accounts)
// ============================================================

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  supabaseId String   @unique
  firstName  String?
  lastName   String?
  phone      String?
  imageUrl   String?
  role       UserRole @default(OWNER)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  salon   Salon?   @relation("SalonOwner")
  stylist Stylist? @relation("StylistUser")

  @@map("users")
}

enum UserRole {
  OWNER
  STYLIST
  ADMIN
}

// ============================================================
// SALON (multi-tenant root)
// ============================================================

model Salon {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  phone       String?
  email       String?
  address     String?
  city        String?
  timezone    String   @default("Australia/Sydney")
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String @unique
  owner   User   @relation("SalonOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  stylists   Stylist[]
  services   Service[]
  categories ServiceCategory[]
  clients    Client[]
  bookings   Booking[]

  @@index([slug])
  @@map("salons")
}

// ============================================================
// STYLISTS
// ============================================================

model Stylist {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  imageUrl  String?
  bio       String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  userId String? @unique
  user   User?   @relation("StylistUser", fields: [userId], references: [id])

  availability StylistAvailability[]
  services     StylistService[]
  bookings     Booking[]

  @@index([salonId])
  @@map("stylists")
}

model StylistAvailability {
  id        String  @id @default(cuid())
  dayOfWeek Int     // 0=Sunday .. 6=Saturday
  startTime String  // "09:00" in salon timezone
  endTime   String  // "18:00"
  isActive  Boolean @default(true)

  stylistId String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek, startTime])
  @@index([stylistId])
  @@map("stylist_availability")
}

// ============================================================
// SERVICES
// ============================================================

model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salonId  String
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services Service[]

  @@index([salonId])
  @@map("service_categories")
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Int      // cents
  duration    Int      // minutes
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salonId    String
  salon      Salon            @relation(fields: [salonId], references: [id], onDelete: Cascade)
  categoryId String?
  category   ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  stylists StylistService[]
  bookings Booking[]

  @@index([salonId])
  @@index([categoryId])
  @@map("services")
}

model StylistService {
  stylistId        String
  stylist          Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  serviceId        String
  service          Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  priceOverride    Int?
  durationOverride Int?

  @@id([stylistId, serviceId])
  @@map("stylist_services")
}

// ============================================================
// CLIENTS (CRM — no app account needed)
// ============================================================

model Client {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  birthDate DateTime? @db.Date
  source    String?   // "walk-in", "instagram", "referral"
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  salonId  String
  salon    Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([salonId])
  @@index([phone])
  @@index([email])
  @@map("clients")
}

// ============================================================
// BOOKINGS
// ============================================================

model Booking {
  id        String        @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(CONFIRMED)
  notes     String?
  price     Int?          // snapshot at booking time

  clientId   String?
  client     Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  guestName  String?
  guestPhone String?

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  stylistId String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Restrict)

  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([salonId, startTime])
  @@index([stylistId, startTime])
  @@index([clientId])
  @@index([status])
  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}
